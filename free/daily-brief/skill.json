{
  "schema": "hearth.skill/1",
  "id": "daily-brief",
  "name": "Daily Brief",
  "version": "0.1.1",
  "author": "hearth-team",
  "description": "Morning briefing \u2014 three world headlines, one weather summary, and a one-line outlook for the day. Single Sonnet hop. Schedule it at 7am via hearth_schedule for a daily delivery to chat.",
  "tier": "free",
  "type": "tool",
  "category": "research",
  "risk": "safe",
  "handler": {
    "runtime": "node",
    "entrypoint": "handler.js",
    "function": "run"
  },
  "permissions": [],
  "api_keys_required": [
    "ANTHROPIC_API_KEY"
  ],
  "vault_inputs": [
    {
      "key": "city",
      "label": "City",
      "kind": "text",
      "placeholder": "Vancouver, BC",
      "help": "City + region the agent should use for the weather line",
      "required": false
    },
    {
      "key": "interests",
      "label": "Topics you care about",
      "kind": "text",
      "placeholder": "AI, crypto, biotech",
      "help": "Comma-separated. Steers the headline picks toward what you actually read",
      "required": false
    }
  ],
  "files": [
    "handler.js"
  ],
  "marketplace": {
    "tags": [
      "llm",
      "anthropic",
      "briefing",
      "morning",
      "schedule"
    ],
    "icon": "Sun"
  },
  "cost_estimate_usd": 0.02,
  "pre_call_message": "Putting your morning brief together\u2026",
  "post_call_message": "Brief is ready",
  "expected_duration_ms": 8000,
  "output_kind": "note",
  "bundled": false,
  "lifecycle_state": "new",
  "cost_estimate": {
    "kind": "per_call",
    "per_call": 0.01
  }
}
